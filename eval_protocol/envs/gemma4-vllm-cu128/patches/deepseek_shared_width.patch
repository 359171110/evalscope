+def _shared_experts_intermediate_size(config) -> int:
+    """Fused shared-MLP width.
+
+    DeepSeek originally sizes the fused shared MLP as
+    ``moe_intermediate_size * n_shared_experts``. Structured pruning may shrink
+    routed experts independently; in that case the checkpoint sets
+    ``shared_expert_intermediate_size`` to the original fused width.
+    """
+    explicit = getattr(config, "shared_expert_intermediate_size", None)
+    if explicit is not None and int(explicit) > 0:
+        return int(explicit)
+    return int(config.moe_intermediate_size) * int(config.n_shared_experts)
+
+
 class DeepseekAttention(nn.Module):
